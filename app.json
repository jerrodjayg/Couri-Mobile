{
  "expo": {
    "name": "Couri",
    "slug": "jerrod",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "owner": "sammymush",
    "sdkVersion": "54.0.0",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": false,
    "scheme": "com.anonymous.jerrod",

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "config":{
        "googleMapsApiKey": "AIzaSyDb06-8lffU7CmFoZtJJkR0d6dQkZqA_mw"
      },
      "bundleIdentifier": "com.anonymous.jerrod",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:gocouri.com",
        "applinks:www.gocouri.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select profile photos.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to show your current position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to show your current position on the map.",
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely log in to your Couri account."
      },
      "runtimeVersion": { "policy": "appVersion" }
    },

    "android": {
      "config":{
        "googleMaps": {
          "apiKey": "AIzaSyAefIF36UbqayA10CzzBSKq3eI_j3e_9Ak"
        }
      },
      "package": "com.anonymous.jerrod",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "com.anonymous.jerrod" }]
        }
      ],
      "runtimeVersion": { "policy": "appVersion" }
    },

    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications",
      "expo-location",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Use Face ID to quickly and securely log in to your Couri account." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app accesses your photos to let you select profile photos.",
          "cameraPermission": "This app accesses your camera to let you take profile photos."
        }
      ]
    ],

    "web": { "favicon": "./assets/favicon.png" },

    "extra": {
      "eas": { "projectId": "0b05ed17-f690-4d7a-9154-abce8e775910" },
