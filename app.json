{
  "expo": {
    "name": "Couri",
    "slug": "jerrod",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "newArchEnabled": true,
    "scheme": "com.anonymous.jerroddd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.jerrod",
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.jerrod"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0b05ed17-f690-4d7a-9154-abce8e775910"
      }
    },
    "owner": "sammymush"
  }
}
